# ─────────────────────────────────────────────────────────────
# MillionaireMind — environment template
# Copy to .env. NEVER commit .env. Keys are read by the backend
# only; the frontend never sees a credential.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
MM_ENV=development
MM_HOST=127.0.0.1
MM_PORT=8000
MM_DB_PATH=./millionairemind.db

# ── Ladder ───────────────────────────────────────────────────
MM_BASE_UNIT=1.00
MM_LADDER_NODES=20
MM_RATCHET_PCT=0.20

# ── Autonomy tier: T0 | T1 | T2 | T3 ─────────────────────────
# T0 = paper only. Anything above T0 requires live adapters,
# which are NOT shipped. Leave at T0.
MM_AUTONOMY_TIER=T0

# ── Risk limits (hard, enforced in code) ─────────────────────
MM_KELLY_FRACTION=0.25
MM_MAX_POSITION_PCT=0.10
MM_MAX_VENUE_PCT=0.35
MM_MAX_TOTAL_RISK_PCT=0.50
MM_MAX_CORRELATION_PCT=0.20
MM_MAX_DAILY_DRAWDOWN_PCT=0.10
MM_MAX_LEVEL_DRAWDOWN_PCT=0.25
MM_MIN_EDGE_PCT=0.02
MM_MAX_LIQUIDITY_FRACTION=0.10

# ── Simulation (T0) ──────────────────────────────────────────
MM_SIM_ENABLED=true
MM_SIM_TICK_SECONDS=2.0
MM_SIM_SEED=1337
# Scales mock venue volatility. 1.0 = one tick is roughly one hour of market
# time. Raise (e.g. 5.0) to stress-test the drawdown breakers on purpose.
MM_SIM_VOL_SCALE=1.0

# ── Live adapters: ALL DISABLED. Placeholders only. ───────────
# The mock adapters ignore these entirely. Setting them does not
# enable live trading — live adapters are not implemented.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
STRIPE_SECRET_KEY=
GOCARDLESS_ACCESS_TOKEN=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
CRYPTO_EXCHANGE_KEY=
CRYPTO_EXCHANGE_SECRET=
CRYPTO_EXCHANGE_TESTNET=true
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
